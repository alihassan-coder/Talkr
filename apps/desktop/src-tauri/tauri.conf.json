{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talkr",
  "version": "0.1.8-1",
  "identifier": "app.talkr",
  "build": {
    "beforeDevCommand": "node scripts/build-engine.mjs --debug && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/build-engine.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talkr",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "backgroundColor": "#0b0b0c"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "worker-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp"
      },
      "wix": {
        "language": "en-US",
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-common",
          "libasound2 | libasound2t64",
          "libvulkan1",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "alsa-lib",
          "vulkan-loader",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMTI4Qjc4QTAxOTBCRUQKUldUdEN4bWdlSXNTWUFQUzhyWXl6UEFFVjhOOEppR21UL09DYWtRcFprOXFQRytEQ3Z6Tk9rTTUK",
      "endpoints": [
        "https://github.com/alihassan-coder/Talkr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
