{
  "compilerOptions": {
    "extends": "@talkr/config/tsconfig.base.json",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@talkr/ui/*": ["../../packages/ui/src/*"],
      "@talkr/model-catalog/*": ["../../packages/model-catalog/*"],
      "@talkr/config/*": ["../../packages/config/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}