{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@talkr/ui/*": ["packages/ui/src/*"],
      "@talkr/model-catalog/*": ["packages/model-catalog/*"],
      "@talkr/config/*": ["packages/config/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "out", "target", ".next"]
}